generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StoreType {
  FEEDS
  LAUNDRY_CAFE
  GROCERY
}

enum UserRole {
  OWNER
  COMPANY_ADMIN
  STORE_MANAGER
  CASHIER
  INVENTORY_STAFF
  LAUNDRY_STAFF
}

model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores    Store[]
  users     User[]
  auditLogs AuditLog[]
  products  Product[]
}

model Store {
  id        String    @id @default(cuid())
  companyId String
  code      String    @unique
  name      String
  type      StoreType
  address   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userAccess    UserStoreAccess[]
  auditLogs     AuditLog[]
  storeProducts StoreProduct[]

  @@index([companyId])
  @@index([companyId, type])
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CASHIER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  storeAccess UserStoreAccess[]
  auditLogs   AuditLog[]

  @@index([companyId])
  @@index([companyId, role])
}

model UserStoreAccess {
  userId     String
  storeId    String
  assignedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@index([storeId])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  storeId    String?
  userId     String?
  action     String
  entityType String
  entityId   String?
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([storeId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model Product {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  sku         String?
  barcode     String?
  brand       String?
  imageUrl    String?
  category    String?
  description String?
  unit        String   @default("piece")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  storeProducts StoreProduct[]

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([companyId, name])
  @@index([companyId, category])
}

model StoreProduct {
  id                String   @id @default(cuid())
  storeId           String
  productId         String
  costPrice         Decimal  @default(0) @db.Decimal(12, 2)
  retailPrice       Decimal  @default(0) @db.Decimal(12, 2)
  wholesalePrice    Decimal? @db.Decimal(12, 2)
  stockQuantity     Decimal  @default(0) @db.Decimal(12, 3)
  lowStockThreshold Decimal  @default(0) @db.Decimal(12, 3)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([storeId, productId])
  @@index([storeId])
  @@index([productId])
}
